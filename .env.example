# Variables d'environnement du site : liste complète (voir README, section 3).
# En local : copier ce fichier en .env.local. Laisser DATABASE_URL et SUPABASE_* vides.
# En production : NE PAS utiliser ce fichier, tout se renseigne dans Vercel
# (Settings → Environment Variables).

# URL publique et définitive du site (balises og:url, sitemap, robots, hreflang).
# Lue au moment du build : redéployer après chaque modification.
NEXT_PUBLIC_SITE_URL=https://www.innovatebf.org

# Base de données PostgreSQL.
# En local : laisser vide pour utiliser la base locale « innovatebf » (postgresql://localhost:5432/innovatebf).
# En production : Vercel, environnement Production uniquement.
# Supabase, bouton « Connect », méthode « Transaction pooler » (port 6543), mot de passe compris.
# Ne jamais mettre l'adresse de production ici : « npm run dev » et « npm run db:setup » écriraient dans la base en ligne.
DATABASE_URL=

# Stockage de fichiers Supabase : images de la médiathèque et pièces jointes des candidatures.
# En production : Vercel, environnement Production uniquement. Le build crée les espaces « media » et « candidatures ».
# SUPABASE_URL : https://<référence du projet>.supabase.co
# SUPABASE_SECRET_KEY : clé secrète (Project Settings → API Keys, sb_secret_…), jamais côté navigateur.
# En local, sans ces variables, les images vont dans data/uploads et les candidats ajoutent leurs pièces par lien.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Premier administrateur, créé par « npm run db:setup » (donc par le build) si aucun compte n'existe.
# Mot de passe : 12 caractères minimum avec lettres et chiffres. Obligatoire en production.
# En local, sans ADMIN_PASSWORD, un mot de passe est généré et affiché.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notifications e-mail des formulaires via Resend (https://resend.com).
# Sans ces trois variables, les envois restent enregistrés dans le back-office, sans e-mail.
# MAIL_FROM doit utiliser un domaine vérifié dans Resend.
RESEND_API_KEY=
MAIL_FROM="InnovateBF <noreply@innovatebf.org>"
# Une ou plusieurs adresses séparées par des virgules
MAIL_TO=contact@innovatebf.org

# Facultatif, local uniquement : dossier des images téléversées sans Supabase (défaut : ./data/uploads)
# UPLOADS_DIR=
